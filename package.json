{
  "name": "dsh-mermaid",
  "version": "1.0.0",
  "description": "DSH Web 插件:自动渲染对话中的 mermaid 代码块,支持缩放/平移/工具栏/SVG 导出。Mermaid 11 已打包进客户端 bundle —— 完全离线,无 CDN,运行时零网络请求。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mermaid",
    "diagram",
    "plugin"
  ],
  "license": "MIT"
}
